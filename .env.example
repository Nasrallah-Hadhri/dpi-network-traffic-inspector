# DPI Network Traffic Inspector - configuration template.
# The scripts read plain environment variables (no .env loader is bundled).
# Usage:  cp .env.example .env  &&  edit  &&  set -a; source .env; set +a
#         then run with `sudo -E` so root keeps these variables.
# Never commit .env.

# Initial admin account, created on first run if it does not exist.
# If DPI_ADMIN_PASSWORD is empty, a random password is generated and printed once.
DPI_ADMIN_USERNAME=admin
DPI_ADMIN_PASSWORD=<choose-a-strong-password>

# Destination IP used by the packet-crafting test scripts (packets.py, send_custom_packets.py).
DPI_TARGET_IP=127.0.0.1

# Dummy value embedded in the "password =" test payload (not a real credential).
DPI_TEST_PAYLOAD_SECRET=<dummy-value>
